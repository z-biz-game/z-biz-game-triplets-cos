  "orientation": "any",
  "background_color": "#070A14",
  "theme_color": "#070A14",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": ["games", "puzzle"],
  "icons": [
    { "src": "./icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
